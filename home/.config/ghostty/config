# Theme: matches the Neovim colorscheme. To switch, uncomment one line and
# reload the config (Cmd+Shift+,). In nvim, ,fc switches the colorscheme.
theme = Gruvbox Material Dark     # nvim: gruvbox-material (default)
# theme = TokyoNight Moon         # nvim: tokyonight-moon
# theme = Rose Pine Moon          # nvim: rose-pine-moon

font-family = Monaco
font-size = 10

# Option acts as Alt (needed for Alt-key shortcuts in nvim/tmux/fish).
macos-option-as-alt = true
# When you ssh somewhere, install Ghostty's terminfo there automatically,
# so tmux/nvim on the remote machine don't complain about the terminal.
shell-integration-features = ssh-terminfo,ssh-env
copy-on-select = clipboard
window-save-state = always
