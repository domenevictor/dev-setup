# dev-setup Brewfile. Works with Homebrew on macOS and on Linux.
# Language runtimes are NOT here: mise manages them (home/.config/mise/config.toml).

# Shell and terminal
brew "fish"
brew "starship"     # prompt
brew "tmux"
brew "mosh"         # mosh-server, for connecting to this machine from Moshi
brew "zoxide"       # `z <dir>` jumps to frequent directories
brew "fzf"

# Editor
brew "neovim"
brew "tree-sitter-cli" # builds syntax parsers for nvim-treesitter

# Search and view
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"
brew "jq"
brew "yq"

# Git
brew "git"
brew "gh"
brew "git-delta"    # nicer diffs (configured as git's pager)
brew "lazygit"

# Languages and builds
brew "mise"         # node, python, rust, bun, pnpm
brew "cmake"
brew "ninja"
brew "pkgconf"

# Linters and formatters used by Neovim
brew "shellcheck"
brew "shfmt"
brew "stylua"

# System
brew "btop"
brew "wget"
